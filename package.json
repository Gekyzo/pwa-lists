{
  "name": "lists",
  "version": "1.0.1",
  "description": "Lists of things: items, their shops as lists and their sections, offline on one phone",
  "private": true,
  "type": "module",
  "imports": {
    "#ds/*": "./vendor/design-system/*.js",
    "#*": "./src/*.js"
  },
  "scripts": {
    "test": "node --test",
    "serve": "python3 -m http.server 8080",
